# Neon Postgres. `neon link` writes both of these to .env.local.
# Pooled: used by the app at runtime.
DATABASE_URL="postgresql://USER:PASS@HOST-pooler/DB?sslmode=require"
# Direct: used by Prisma Migrate only.
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""
# Optional locally. Set to the public URL in production.
# AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
