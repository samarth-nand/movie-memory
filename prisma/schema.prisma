generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js required tables ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application tables ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // null = not yet onboarded; non-null = onboarding complete
  favoriteMovie String?

  accounts Account[]
  sessions Session[]
  facts    Fact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fact {
  id         String   @id @default(cuid())
  userId     String
  // Snapshot of the movie at generation time — decoupled from User.favoriteMovie
  // so history stays correct if the user later changes their movie.
  movieTitle String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Covers the only query pattern: "latest fact for this user and this movie"
  // DESC on createdAt means the first row returned is the newest — no sort step.
  @@index([userId, movieTitle, createdAt(sort: Desc)])
}
