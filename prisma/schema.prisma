generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js required tables ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application tables ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // null = not yet onboarded; non-null = onboarding complete.
  // VarChar(100) backs up the app's 1-100 rule in the database. Postgres counts
  // characters (code points); JS counts UTF-16 units, which is never fewer, so
  // anything the app accepts fits.
  favoriteMovie String? @db.VarChar(100)

  accounts Account[]
  sessions Session[]
  facts    Fact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fact {
  id         String   @id @default(cuid())
  userId     String
  // Snapshot of the movie at generation time — decoupled from User.favoriteMovie
  // so history stays correct if the user later changes their movie.
  movieTitle String   @db.VarChar(100) // same limit as User.favoriteMovie
  content    String   @db.Text
  // Set by the database, never the app server, because the 60-second cache window
  // is measured against the database clock. clock_timestamp() rather than now():
  // inside a transaction now() is frozen at transaction start, which would
  // backdate a fact by however long the OpenAI call took. timestamptz so the
  // age arithmetic doesn't depend on the session time zone.
  createdAt  DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Covers the only query pattern: "latest fact for this user and this movie"
  // DESC on createdAt means the first row returned is the newest — no sort step.
  @@index([userId, movieTitle, createdAt(sort: Desc)])
}
